{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": "scripts/",
    "outDir": "./dist"
  },
  "exclude": [
    "node_modules"
  ],
  "include": ["scripts/**/*.ts"]
}
